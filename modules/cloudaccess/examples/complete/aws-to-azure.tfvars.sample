# Resource suffix is optional, specify this if you need to keep role definitions unique amongst
# multiple workspaces using the same subscription.
region                                = "uksouth"
resource_suffix                       = "app1-nonprod"
enable_cluster_manager_permissions    = true
enable_dns_zone_manager_permissions   = true
enable_network_manager_permissions    = true
enable_cloud_info_permissions         = false
from_aws                              = true
from_azure                            = false
wayfinder_identity_aws_issuer         = "https://oidc.eks.eu-west-2.amazonaws.com/id/ABCDF8D2EF45CE1A6FD96E2781310123"
wayfinder_identity_aws_subject        = "system:serviceaccount:wayfinder:wayfinder-admin"
subscription_id                       = "12345678-abcd-1234-5678-abcdabcdabcd"

# Example of custom role assignments
custom_roles = [
  {
    scope              = "/subscriptions/12345678-abcd-1234-5678-abcdabcdabcd"
    role_definition_id = "/subscriptions/12345678-abcd-1234-5678-abcdabcdabcd/providers/Microsoft.Authorization/roleDefinitions/12345678-abcd-1234-5678-abcdabcdabcd"
  }
]
